server {
	listen 80;
	root /usr/share/nginx/html;
	client_max_body_size 10m;

	# The ERP's API (the cars, the customers' requests) and its files (the cars' photos)
	location ~ ^/(api|files)/ {
		proxy_pass ${ERP};
		proxy_set_header Host ${ERP_HOST};
		proxy_set_header X-Forwarded-For $remote_addr;
		proxy_set_header X-Forwarded-Proto $scheme;
	}

	# Every page of the site is index.html (the site picks the page from the address)
	location / {
		try_files $uri /index.html;
	}

	location /assets/ {
		expires 30d;
		add_header Cache-Control "public, immutable";
	}
}
